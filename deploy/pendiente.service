[Unit]
Description=Pendiente meal server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pendiente
Environment=PORT=3011
Environment=PENDIENTE_DB=/home/ubuntu/pendiente-data/pendiente.sqlite
Environment=PENDIENTE_DATA_DIR=/home/ubuntu/pendiente-data
Environment=STELLAR_ENABLED=true
EnvironmentFile=/home/ubuntu/pendiente-data/server.env
Environment=STELLAR_CONTRACT_ID=CCEWVBHEO7K6GH2C2WVB6RBGPWASFJGGLC67XBYA3VVE6KF6CCLAMNWQ
Environment=STELLAR_TOKEN_CONTRACT_ID=CCOLZD3JWJPN4UWS64TO3ZNJQYYYOJQ3QAUVW47GOIVLMXP6HXQ73K6Z
Environment=STELLAR_RPC_URL=https://soroban-testnet.stellar.org
Environment=STELLAR_NETWORK=testnet
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
